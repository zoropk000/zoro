# Local development serves the existing API through Vite. A second server is optional.
VITE_API_URL=/api

# For same-domain Vercel full-app deployment, leave VITE_API_URL unset
# or set it to:
# VITE_API_URL=/api
#
# For separate backend deployment, set this to your deployed backend URL:
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api
# To proxy to a separately running local backend, set this before npm run dev:
# ZORO_DEV_API_PROXY=http://127.0.0.1:5001

# Server/API environment variables for Vercel:
MONGODB_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=ZORO
EMAIL_SITE_URL=https://zoro-ruddy.vercel.app
# Defaults to the authenticated sender; use one monitored mailbox.
EMAIL_ADMIN_TO=
# Optional SMTP for a provider-verified domain. Leave these blank to keep Gmail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_RETURN_PATH=
# Optional local DKIM only when your provider does not sign your own domain.
EMAIL_DKIM_DOMAIN=
EMAIL_DKIM_SELECTOR=
EMAIL_DKIM_PRIVATE_KEY=
# EMAIL_ENABLED=false disables all outgoing email (including admin notifications).

# Optional: enables automatic WhatsApp messages on Vercel through WhatsApp Cloud API.
# whatsapp-web.js/browser sessions cannot run inside Vercel serverless functions.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
