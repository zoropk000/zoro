# Local development with the backend running on port 5000:
VITE_API_URL=http://localhost:5000/api

# For same-domain Vercel full-app deployment, leave VITE_API_URL unset
# or set it to:
# VITE_API_URL=/api
#
# For separate backend deployment, set this to your deployed backend URL:
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN/api

# Server/API environment variables for Vercel:
MONGODB_URI=
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=ZORO

# Optional: enables automatic WhatsApp messages on Vercel through WhatsApp Cloud API.
# whatsapp-web.js/browser sessions cannot run inside Vercel serverless functions.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v20.0
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
